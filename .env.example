# Meta Automation — Digital Product Selling System
# Configuration Template — copy to .env and fill in your values

# ─────────────────────────────────────────────────────────────────
# AI RUNTIME CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# Primary provider: Antigravity CLI (agy). MiniMax/OpenAI are fallbacks.
AI_PROVIDER=antigravity
AI_RUNTIME=antigravity
AI_MODEL=Gemini 3.8 Flash

# Antigravity CLI settings
ANTIGRAVITY_CLI_BIN=agy
ANTIGRAVITY_MODEL=
ANTIGRAVITY_EFFORT=high
ANTIGRAVITY_TIMEOUT_MS=120000

# Optional: MiniMax M3 API (fallback if Antigravity is unavailable)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_ENDPOINT=/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT_MS=90000
MINIMAX_MAX_RETRIES=2
MINIMAX_TEMPERATURE=0.2
MINIMAX_MAX_TOKENS=4096
MINIMAX_THINKING=true

# Optional: Gemini API (for agentic vision features)
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────
# BROWSER CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# BROWSER_TYPE: chrome | edge | brave | chromium | auto (auto-detects)
BROWSER_TYPE=chrome
BROWSER_PROFILE=Profile 1
THREADS_CDP_URL=http://127.0.0.1:9222
DISPLAY=:1

# ─────────────────────────────────────────────────────────────────
# OPERATIONAL MODES
# ─────────────────────────────────────────────────────────────────
# APPROVAL_MODE: true = requires human confirmation, false = fully autonomous
APPROVAL_MODE=false

# DRY_RUN: true = simulate only (no real posts), false = live posting
DRY_RUN=false

# POSTING_ENABLED: master safety switch for live publishing
POSTING_ENABLED=true

# ─────────────────────────────────────────────────────────────────
# RATE LIMITS (actions per hour)
# ─────────────────────────────────────────────────────────────────
MAX_NEW_POST_REPLIES_PER_HOUR=5
MAX_TOTAL_REPLIES_PER_HOUR=15
MAX_DM_REPLIES_PER_HOUR=10

# ─────────────────────────────────────────────────────────────────
# TIMING & SCANNER SETTINGS
# ─────────────────────────────────────────────────────────────────
# Delay between browser actions (milliseconds) — keeps behavior human-like
MIN_ACTION_DELAY_MS=15000
MAX_ACTION_DELAY_MS=45000

# How often the engagement scanner runs (seconds)
SCAN_INTERVAL_SECONDS=300

# Max posts to scan per cycle
MAX_POSTS_PER_SCAN=50

# Publishing cadence (hours between posts)
POST_INTERVAL_HOURS=3

# ─────────────────────────────────────────────────────────────────
# AGENTIC SOCIAL VISION (advanced — optional)
# ─────────────────────────────────────────────────────────────────
ANTIGRAVITY_AGENT=antigravity-preview-09-2026
ANTIGRAVITY_VISION_MODEL=gemini-3.8-flash
SOCIAL_AGENT_MAX_ITERATIONS=8
